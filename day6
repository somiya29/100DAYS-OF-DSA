#include <stdio.h>

int main() {
    int arr[100], n;

    printf("Enter size (sorted array): ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for (int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    int k = 1;

    for (int i = 1; i < n; i++) {
        if (arr[i] != arr[k - 1]) {
            arr[k] = arr[i];
            k++;
        }
    }

    printf("Array after removing duplicates:\n");
    for (int i = 0; i < k; i++)
        printf("%d ", arr[i]);

    printf("\nNew size: %d", k);

    return 0;
}
